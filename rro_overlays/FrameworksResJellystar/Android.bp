// An explicit product RRO rather than DEVICE_PACKAGE_OVERLAYS: those are turned into a vendor
// RRO, and the vendor partition on this device is the stock prebuilt, so it never ships.
runtime_resource_overlay {
    name: "FrameworksResJellystar",
    product_specific: true,
}
