<resources>
    <!-- Bigger PIN keys on the lock screen. On the 480x854 screen the PIN pad is limited by height,
         so the keys get the height AOSP keeps under the emergency button (60 dp; the bouncer's
         bottom padding is the larger of this and the navigation bar inset, so a navigation bar is
         still cleared) and part of the gaps between rows (12 dp): 99 px keys instead of 76 px. -->
    <dimen name="keyguard_security_view_bottom_margin">16dp</dimen>
    <dimen name="num_pad_entry_row_margin_bottom">6dp</dimen>
    <!-- Space between keys as on stock Android 16 (V01.00.04), whose MtkSystemUI sets 36 dp (AOSP:
         12 dp below sw360dp; this screen is sw349dp): spreads the pad across the screen. Read with
         `aapt2 dump resources` from /system_ext/priv-app/MtkSystemUI. -->
    <dimen name="num_pad_key_margin_end">36dp</dimen>
</resources>
