<resources>
    <!-- Lock screen PIN pad as on stock Android 16 (V01.00.04): its MtkSystemUI sets the space between
         keys to 36 dp (AOSP: 12 dp below sw360dp; this screen is sw349dp), which spreads the pad across
         the screen. Read with `aapt2 dump resources` from /system_ext/priv-app/MtkSystemUI; the other
         keypad dimensions (key width, row spacing, bottom margin) are the same as AOSP's. -->
    <dimen name="num_pad_key_margin_end">36dp</dimen>
</resources>
