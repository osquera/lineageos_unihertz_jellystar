    Vendor HALs in the stock manifests that hardware/mediatek's framework matrix doesn't list.
-->
<compatibility-matrix version="9.0" type="framework">
    <hal format="aidl" optional="true">
        <name>vendor.mediatek.hardware.agolddaemon</name>
        <version>2</version>
        <interface>
            <name>IAgoldDaemon</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="aidl" optional="true">
        <name>vendor.mediatek.hardware.aguiledbelt</name>
        <version>1</version>
        <interface>
            <name>IAguiLedBeltLight</name>
            <instance>default</instance>
        </interface>
    </hal>
    <!-- hardware/mediatek lists versions 1-2; the stock service is version 3. -->
    <hal format="aidl" optional="true">
        <name>vendor.mediatek.hardware.mtkpower</name>
        <version>3</version>
        <interface>
            <name>IMtkPowerService</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="aidl" optional="true">
        <name>vendor.tms.tmsnfc_aidl</name>
        <version>1</version>
        <interface>
            <name>ITmsNfc</name>
            <instance>default</instance>
        </interface>
    </hal>
</compatibility-matrix>
