<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.lineageos.jellystar.ledbelt"
    android:sharedUserId="android.uid.system">

    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Persistent so it can follow screen, charger and phone state for the effects. -->
    <application
        android:name=".LedBeltApp"
        android:persistent="true"
        android:label="@string/app_name"
        android:icon="@drawable/ic_ledbelt">

        <service
            android:name=".LedBeltTileService"
            android:exported="true"
            android:icon="@drawable/ic_ledbelt"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>

        <!-- Notification pulse. Granted by default via config_defaultListenerAccessPackages. -->
        <service
            android:name=".LedBeltNotificationListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- For key remapping apps: broadcast org.lineageos.jellystar.ledbelt.action.TOGGLE. -->
        <receiver
            android:name=".LedBeltToggleReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="org.lineageos.jellystar.ledbelt.action.TOGGLE" />
            </intent-filter>
        </receiver>

        <!-- Opened from Settings > Display > Lights and by long-pressing the tile. -->
        <activity
            android:name=".LedBeltActivity"
            android:exported="true"
            android:label="@string/lights_title"
            android:theme="@android:style/Theme.DeviceDefault.DayNight">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.android.settings.action.IA_SETTINGS" />
            </intent-filter>
            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.display" />
            <meta-data
                android:name="com.android.settings.summary"
                android:resource="@string/lights_summary" />
        </activity>

        <activity
            android:name=".RedKeyActivity"
            android:exported="true"
            android:label="@string/redkey_title"
            android:theme="@android:style/Theme.DeviceDefault.DayNight">
            <intent-filter>
                <action android:name="com.android.settings.action.IA_SETTINGS" />
            </intent-filter>
            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.system" />
            <meta-data
                android:name="com.android.settings.summary"
                android:resource="@string/redkey_summary" />
        </activity>

        <activity
            android:name=".ChargeLimitActivity"
            android:exported="true"
            android:label="@string/charge_limit_title"
            android:theme="@android:style/Theme.DeviceDefault.DayNight">
            <intent-filter>
                <action android:name="com.android.settings.action.IA_SETTINGS" />
            </intent-filter>
            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.battery" />
            <meta-data
                android:name="com.android.settings.summary"
                android:resource="@string/charge_limit_summary" />
        </activity>

        <activity
            android:name=".AppColorsActivity"
            android:exported="false"
            android:theme="@android:style/Theme.DeviceDefault.DayNight" />
    </application>
</manifest>
