<!--
     The stock vendor declares android.hardware.biometrics.face and registers a face HAL that
     only works with Unihertz's modified framework. Without this, Settings offers face unlock
     that never works.
-->
<permissions>
    <unavailable-feature name="android.hardware.biometrics.face" />
</permissions>
