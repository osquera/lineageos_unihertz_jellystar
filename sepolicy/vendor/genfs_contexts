# Power supplies (read by the health HAL)
genfscon sysfs /devices/platform/soc/10026000.pwrap/10026000.pwrap:battery-manager/power_supply   u:object_r:sysfs_batteryinfo:s0
genfscon sysfs /devices/platform/soc/1101a000.i2c/i2c-6/6-002f/power_supply                          u:object_r:sysfs_batteryinfo:s0
genfscon sysfs /devices/platform/soc/11017000.i2c/i2c-5/5-0053/power_supply                          u:object_r:sysfs_batteryinfo:s0

# Wakeup sources (read by system_suspend). genfscon matches by prefix, so .../wakeup covers wakeupN.
genfscon sysfs /devices/platform/charger/power_supply/mtk-mst-hvdiv-chg/wakeup                      u:object_r:sysfs_wakeup:s0
genfscon sysfs /devices/platform/charger/power_supply/mtk-slv-hvdiv-chg/wakeup                      u:object_r:sysfs_wakeup:s0
genfscon sysfs /devices/platform/soc/10026000.pwrap/10026000.pwrap:battery-manager/power_supply/battery/wakeup u:object_r:sysfs_wakeup:s0
genfscon sysfs /devices/platform/soc/1101a000.i2c/i2c-6/6-002f/wakeup                                u:object_r:sysfs_wakeup:s0
genfscon sysfs /devices/platform/soc/1101a000.i2c/i2c-6/6-002f/power_supply/oz8806/wakeup            u:object_r:sysfs_wakeup:s0
genfscon sysfs /devices/platform/soc/11015000.i2c/i2c-3/3-0028/wakeup                                u:object_r:sysfs_wakeup:s0
genfscon sysfs /devices/platform/soc/11017000.i2c/i2c-5/5-004e/wakeup                                u:object_r:sysfs_wakeup:s0
genfscon sysfs /devices/platform/soc/11017000.i2c/i2c-5/5-004e/tcpc/type_c_port0/wakeup              u:object_r:sysfs_wakeup:s0
genfscon sysfs /devices/platform/soc/11017000.i2c/i2c-5/5-0053/wakeup                                u:object_r:sysfs_wakeup:s0
genfscon sysfs /devices/platform/soc/11017000.i2c/i2c-5/5-0053/power_supply/primary_chg/wakeup       u:object_r:sysfs_wakeup:s0

# EARA I/O boost
genfscon proc /blocktag/earaio u:object_r:proc_earaio:s0

# FourSemi smart amplifier, read by the audio HAL
genfscon sysfs /class/frsm_amp u:object_r:sysfs_frsm_amp:s0
