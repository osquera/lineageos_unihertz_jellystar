type kedump_collect, domain;
type kedump_collect_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(kedump_collect)

allow kedump_collect vendor_shell_exec:file rx_file_perms;
allow kedump_collect vendor_toolbox_exec:file rx_file_perms;

allow kedump_collect block_device:dir search;
allow kedump_collect expdb_block_device:lnk_file read;
allow kedump_collect expdb_block_device:blk_file rw_file_perms;

allow kedump_collect aee_exp_vendor_file:dir rw_dir_perms;
allow kedump_collect aee_exp_vendor_file:file create_file_perms;
