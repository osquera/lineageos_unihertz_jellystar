# Agold daemon (vendor.mediatek.hardware.agolddaemon), used by the camera HAL.
type hal_aidl_agolddaemon_default, domain;
type hal_aidl_agolddaemon_default_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(hal_aidl_agolddaemon_default)

binder_use(hal_aidl_agolddaemon_default)
add_service(hal_aidl_agolddaemon_default, hal_aidl_agolddaemon_service)

allow hal_aidl_agolddaemon_default agui_device:chr_file { ioctl open read write };
