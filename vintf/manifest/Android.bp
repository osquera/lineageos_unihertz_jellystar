//
// Stock VINTF fragments for services that have no extracted fragment. VINTF XML can't be
// installed with PRODUCT_COPY_FILES. The audio one is renamed from stock's
// android.hardware.audio.service-aidl.xml, which clashes with the AOSP default
// implementation's fragment.
vintf_fragment {
    name: "android.hardware.audio.service-aidl.mediatek.xml",
    src: "android.hardware.audio.service-aidl.mediatek.xml",
    vendor: true,
}

vintf_fragment {
    name: "android.hardware.bluetooth-service-mediatek.xml",
    src: "android.hardware.bluetooth-service-mediatek.xml",
    vendor: true,
}
